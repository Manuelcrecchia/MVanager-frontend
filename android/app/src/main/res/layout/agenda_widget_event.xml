<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/agenda_event_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp" android:minHeight="48dp">
    <TextView android:id="@+id/agenda_event_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/agenda_muted" />
    <TextView android:id="@+id/agenda_event_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/agenda_text" />
    <TextView android:id="@+id/agenda_event_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/agenda_muted" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/agenda_navigate" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center" android:paddingRight="20dp" android:text="Naviga" android:textSize="14sp" android:textColor="@color/agenda_accent" android:visibility="gone" />
        <TextView android:id="@+id/agenda_call" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center" android:text="Chiama" android:textSize="14sp" android:textColor="@color/agenda_accent" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
