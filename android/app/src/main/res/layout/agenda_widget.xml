<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/agenda_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/agenda_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="MVanager · La mia agenda" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/agenda_text" />
        <TextView android:id="@+id/agenda_add" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="+" android:contentDescription="Nuovo evento" android:textSize="26sp" android:textColor="@color/agenda_accent" />
    </LinearLayout>
    <TextView android:id="@+id/agenda_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:textSize="12sp" android:textColor="@color/agenda_muted" />
    <ListView android:id="@+id/agenda_events" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="8dp" />
    <TextView android:id="@+id/agenda_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="12dp" android:text="Apri MVanager per attivare il widget" android:textSize="14sp" android:textColor="@color/agenda_text" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/agenda_updated" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/agenda_muted" />
    </LinearLayout>
</LinearLayout>
